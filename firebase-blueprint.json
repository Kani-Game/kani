{
  "entities": {
    "Game": {
      "title": "Game",
      "description": "Game or merchandise product in catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier" },
        "name": { "type": "string", "description": "Title of the game or product", "maxLength": 300 },
        "tag": { "type": "string", "description": "Category tag e.g. Steam Offline, Product, Free", "maxLength": 100 },
        "genre": { "type": "string", "description": "Game genre or product category", "maxLength": 100 },
        "img": { "type": "string", "description": "Cover artwork image URL or data URL" },
        "link": { "type": "string", "description": "Optional download or official store URL" },
        "description": { "type": "string", "description": "Optional short description or receipt details" },
        "price": { "type": "number", "description": "Selling price in USD" },
        "costPrice": { "type": "number", "description": "Buy-in cost price in USD" },
        "barcode": { "type": "string", "description": "Optional SKU or barcode" },
        "stock": { "type": "number", "description": "Optional inventory count" },
        "createdAt": { "type": "string", "description": "ISO timestamp" },
        "steamSpec": { "type": "object", "description": "Saved Steam PC system requirements and metadata" },
        "skipSteamLink": { "type": "boolean", "description": "When true, skip automatic Steam Store linking by game name" }
      },
      "required": ["name", "tag", "genre", "img"]
    },
    "SteamSpec": {
      "title": "SteamSpec",
      "description": "Cached Steam PC system requirements and metadata",
      "type": "object",
      "properties": {
        "appId": { "type": "number" },
        "matchedName": { "type": "string" },
        "steamUrl": { "type": "string" },
        "coverImage": { "type": "string" },
        "genres": { "type": "array" },
        "primaryGenre": { "type": "string" },
        "developers": { "type": "array" },
        "publishers": { "type": "array" },
        "releaseDate": { "type": "string" },
        "minimum": { "type": "object" },
        "recommended": { "type": "object" },
        "fetchedAt": { "type": "number" }
      },
      "required": ["appId", "matchedName", "minimum", "recommended"]
    },
    "POSSale": {
      "title": "POSSale",
      "description": "Completed point-of-sale cashier transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "receiptNo": { "type": "string" },
        "date": { "type": "string" },
        "totalUsd": { "type": "number" },
        "totalKhr": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "cashierName": { "type": "string" }
      },
      "required": ["id", "receiptNo", "totalUsd", "date"]
    },
    "DailyReportRow": {
      "title": "DailyReportRow",
      "description": "Ledger financial row for daily profit calculation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "gameName": { "type": "string" },
        "category": { "type": "string" },
        "buyIn": { "type": "number" },
        "sellOut": { "type": "number" },
        "profit": { "type": "number" },
        "date": { "type": "string" }
      },
      "required": ["id", "gameName", "category", "buyIn", "sellOut", "profit", "date"]
    },
    "ExpenseItem": {
      "title": "ExpenseItem",
      "description": "Shop operating expenses item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" }
      },
      "required": ["id", "name", "price"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global storefront and POS settings",
      "type": "object",
      "properties": {
        "portalTitle": { "type": "string" },
        "portalSubtitle": { "type": "string" },
        "heroMainTitle": { "type": "string", "description": "Editable main cover display title on HeroBanner" },
        "heroBadge": { "type": "string" },
        "heroTitle": { "type": "string" },
        "heroDescription": { "type": "string" },
        "heroMediaType": { "type": "string", "enum": ["photo", "video"], "description": "Cover background media mode" },
        "heroMediaLayout": { "type": "string", "enum": ["side", "full"], "description": "Cover layout: side artwork panels or full background" },
        "heroCoverImage": { "type": "string", "description": "Custom cover photo URL or compressed data URL" },
        "heroCoverRightImage": { "type": "string", "description": "Optional separate right-side cover photo URL" },
        "heroCoverVideo": { "type": "string", "description": "Custom cover video URL (MP4/WebM/YouTube or /uploads path)" },
        "khrExchangeRate": { "type": "number" },
        "posCashierName": { "type": "string" },
        "coverCards": { "type": "array", "description": "Featured storefront cover promo cards" }
      }
    },
    "ReportSavings": {
      "title": "ReportSavings",
      "description": "Financial report transfer inputs and previous month savings base balances with monthly auto carry-forward",
      "type": "object",
      "properties": {
        "transferToSave": { "type": "number" },
        "transferToSaveD": { "type": "number" },
        "prevSave": { "type": "number" },
        "prevSaveD": { "type": "number" },
        "baseMonthKey": { "type": "string" },
        "monthlyTransfers": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/games/{gameId}": {
      "schema": { "$ref": "#/entities/Game" },
      "description": "Collection of games and products synced across all browsers and devices"
    },
    "/steamSpecs/{specId}": {
      "schema": { "$ref": "#/entities/SteamSpec" },
      "description": "Saved Steam PC system requirements synced for all storefront visitors"
    },
    "/sales/{saleId}": {
      "schema": { "$ref": "#/entities/POSSale" },
      "description": "Point of sale completed receipts"
    },
    "/reportRows/{rowId}": {
      "schema": { "$ref": "#/entities/DailyReportRow" },
      "description": "Daily ledger rows"
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/ExpenseItem" },
      "description": "Operating expenses"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Portal, POS, and Financial Report savings configuration settings"
    },
    "/versionHistory/{versionId}": {
      "schema": { "type": "object" },
      "description": "Daily report versions and ledger snapshots"
    }
  }
}
